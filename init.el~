;; where noise will go
(setq custom-file (locate-user-emacs-file "custom.el"))
(load custom-file 'noerror)

;; package archives
(require 'package)
(add-to-list 'package-archives '("melpa" . "https://melpa.org/packages/") t)
(package-initialize)

;; edit made on emacs
(menu-bar-mode -1)
(tool-bar-mode -1)
(scroll-bar-mode -1)

;; NOTES
;; Single source of truth for where notes live
(setq org-directory "C:/users/gabri/Documents/emacs/emacs-org")
(unless (file-directory-p org-directory)
  (make-directory org-directory))

;; org-agenda scans this — pointing at the directory (not a file list)
;; means any new .org file you drop in here is picked up automatically
(setq org-agenda-files (list org-directory))

;; C-c <letter> is the convention for YOUR bindings — no mode ever claims it
(global-set-key (kbd "C-c c") #'org-capture)
(global-set-key (kbd "C-c a") #'org-agenda)

(setq org-capture-templates
      '(("t" "Task" entry (file+headline "inbox.org" "Tasks")
         "* TODO %?\n  %U")
        ("n" "Note" entry (file+headline "inbox.org" "Notes")
         "* %?\n  %U")))

;; PROJECTS
(setq project-list-file "C:/Users/gabri/Documents/emacs/projects")

;; THEME
(require 'use-package)
(setq use-package-always-ensure t)

;; I love space macs (https://github.com/syl20bnr/spacemacs)
(use-package spacemacs-theme
  :init (load-theme 'spacemacs-dark t))

(use-package doom-modeline
  :init (doom-modeline-mode 1))

(use-package dashboard
  :init (dashboard-setup-startup-hook)
  :config
  (setq dashboard-items '((recents . 5) (projects . 5) (agenda . 5))))

(use-package diff-hl
  :init (global-diff-hl-mode))

(set-face-attribute 'default nil :family "Cascadia Code" :height 110
		    :weight 'normal)

;; now the actual useful stuff for coding
(use-package rust-mode
  :init (setq rust-mode-treesitter-derive nil))
(use-package eglot
  :hook (rust-mode . eglot-ensure))

(use-package treemacs)
(use-package corfu
  :custom
  (corfu-auto t)
  (corfu-auto-delay 0.1)
  (corfu-auto-prefix 1)
  :init (global-corfu-mode))

(defun my/open-project ()
  "Switch project, then show it in treemacs automatically."
  (interactive)
  (call-interactively #'project-switch-project)
  (treemacs-add-and-display-current-project))

(global-set-key (kbd "C-x p p") #'my/open-project)
